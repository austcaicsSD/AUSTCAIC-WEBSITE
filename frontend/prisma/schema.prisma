generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Member {
  id         String   @id @default(uuid())
  fullName   String
  studentId  String   @unique
  email      String   @unique
  memberId   String?  @unique
  phone      String
  department String
  semester   String
  createdAt  DateTime @default(now())
}

model PanelMember {
  id            String   @id @default(uuid())
  name          String
  memberId      String?
  semester      String
  role          String
  wing          String?
  personalEmail String?
  facebookUrl   String?
  linkedinUrl   String?
  imageUrl      String?
  orderIndex    Int      @default(0)
  createdAt     DateTime @default(now())

  @@map("panel_members")
}

